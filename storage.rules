rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function active() {
      return signedIn() && request.auth.token.accountStatus == 'active';
    }

    function admin() {
      return active() && request.auth.token.role == 'admin';
    }

    function editor() {
      return active() && request.auth.token.role in ['editor', 'admin'];
    }

    function safeImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    function safeTicketAttachment() {
      return request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)|application/pdf');
    }

    match /avatars/{uid}/{fileId} {
      allow read: if active();
      allow create, update: if active() && request.auth.uid == uid && safeImage();
      allow delete: if active() && request.auth.uid == uid;
    }

    match /tickets/{ownerUid}/{ticketId}/{messageId}/{fileId} {
      allow read: if admin() || (active() && request.auth.uid == ownerUid);
      allow create: if active()
        && (request.auth.uid == ownerUid || admin())
        && safeTicketAttachment();
      allow update: if false;
      allow delete: if admin() || (active() && request.auth.uid == ownerUid);
    }

    match /staging/{editorUid}/{requestId}/{fileId} {
      allow read: if admin() || (editor() && request.auth.uid == editorUid);
      allow create: if editor()
        && request.auth.uid == editorUid
        && request.resource.size <= 1024 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Published geospatial files are public data. Only trusted Cloud Functions
    // write to these paths after an administrator approves a change request.
    match /webgis/raster/{layerId}/{revision}/{fileId} {
      allow read: if true;
      allow write: if false;
    }

    match /webgis/vetor/{layerId}/{revision}/{fileId} {
      allow read: if true;
      allow write: if false;
    }

    // Observatory PDFs are public once published; trusted Cloud Functions copy
    // approved uploads from staging into this namespace.
    match /Observatorio/{publicationId}/{revision}/{fileId} {
      allow read: if true;
      allow write: if false;
    }

    match /exports/{uid}/{jobId}/{fileId} {
      allow read: if admin() || (active() && request.auth.uid == uid);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
