rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function active() {
      return signedIn() && request.auth.token.accountStatus == 'active';
    }

    function admin() {
      return active() && request.auth.token.role == 'admin';
    }

    function editor() {
      return active() && request.auth.token.role in ['editor', 'admin'];
    }

    function safeImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    match /avatars/{uid}/{fileId} {
      allow read: if active();
      allow create, update: if active() && request.auth.uid == uid && safeImage();
      allow delete: if active() && request.auth.uid == uid;
    }

    match /tickets/{ownerUid}/{ticketId}/{messageId}/{fileId} {
      allow read: if admin() || (active() && request.auth.uid == ownerUid);
      allow create: if active()
        && request.auth.uid == ownerUid
        && request.resource.size <= 15 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /staging/{editorUid}/{requestId}/{fileId} {
      allow read: if admin() || (editor() && request.auth.uid == editorUid);
      allow create: if editor()
        && request.auth.uid == editorUid
        && request.resource.size <= 250 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /layers/{layerId}/{revision}/{fileId} {
      allow read: if active();
      allow write: if false;
    }

    match /publications/{publicationId}/{revision}/{fileId} {
      allow read: if active();
      allow write: if false;
    }

    match /exports/{uid}/{jobId}/{fileId} {
      allow read: if admin() || (active() && request.auth.uid == uid);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

