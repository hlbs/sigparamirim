{
  "name": "sig-paramirim",
  "version": "0.3.0-beta.16",
  "private": true,
  "description": "Plataforma científica e WebGIS da Bacia Hidrográfica do Rio Paramirim.",
  "workspaces": [
    "apps/*",
    "functions",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sig-paramirim/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:rules": "vitest run tests/firestore.rules.test.ts",
    "lint": "npm run lint --workspaces --if-present",
    "import:morphometry": "tsx scripts/import-morphometry.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "retry-request": "9.0.1"
  },
  "packageManager": "npm@11.1.0",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "read-excel-file": "^9.3.10",
    "tsx": "^4.20.6"
  }
}
